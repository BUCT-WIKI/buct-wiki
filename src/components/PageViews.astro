---
<span id="page-views" aria-live="polite">阅读量：...</span>

<script>
	import { requestD1Function } from '../utils/d1-api';

    const el = document.querySelector('#page-views');

    if (el) {
        requestD1Function<{ views: number }>('/api/page-views', {
			path: window.location.pathname,
		})
            .then((data) => {
				if (data === null) {
					el.textContent = '阅读量：--';
				} else if (typeof data.views === 'number') {
                    el.textContent = `阅读量：${data.views}`;
                }
            })
            .catch(() => {
                el.textContent = '阅读量：--';
            });
    }
</script>
