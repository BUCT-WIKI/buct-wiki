---
import { Card } from '@astrojs/starlight/components';

interface Props {
	text: string;
	icon: string;
	desc: string;
	url: string;
}

const { text, icon, desc, url } = Astro.props;
---

<a
	href={url}
	target="_blank"
	rel="noopener noreferrer"
	aria-label={`${text}：${desc}`}
	style="display: block; color: inherit; text-decoration: none;"
>
	<div style="position: relative; width: 100%; height: 0; padding-bottom: 40%;">
		<div data-navigation-card style="position: absolute; inset: 0; overflow: hidden;">
			<Card title={text}>
			<p>{desc}</p>
			<img
				src={icon}
				alt=""
				loading="lazy"
				onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
				style="
                    position: absolute;
                    top: 0;
                    right: 0;
                    width: 50%;
                    height: 100%;
                    margin: 0;
                    padding: 0;
                    object-fit: contain;
                    object-position: right top;
                    opacity: 0.25;
                    pointer-events: none;
                "
			/>
			<img
				src="/icons/navigation-fallback.svg"
				alt=""
				aria-hidden="true"
				style="
					display: none;
					position: absolute;
					top: 0;
					right: 0;
					width: 50%;
					height: 100%;
					margin: 0;
					object-fit: contain;
					object-position: right top;
					opacity: 0.35;
					pointer-events: none;
				"
			/>
			</Card>
		</div>
	</div>
</a>

<style>
	[data-navigation-card] :global(.card) {
		position: relative;
		box-sizing: border-box;
		height: 100%;
		min-height: 0;
		overflow: hidden;
		border-radius: 0.75rem;
		padding: 1rem;
		gap: 0.5rem;
	}
</style>
