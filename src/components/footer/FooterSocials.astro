---
import { snc, socialAccounts } from '../../data/footer';
import { socialQrSource } from '../../utils/social-qr.mjs';
import FooterIcon from './FooterIcon.astro';

const accounts = socialAccounts.map((account) => ({
	...account,
	source: account.code.kind === 'qr' ? socialQrSource(account.code.value) : account.code.value,
}));
const wechat = accounts[0];
---

<snc-socials aria-labelledby="snc-follow-title">
	<h2 id="snc-follow-title">发现更多 SNC<span class="account-name">{snc.name}</span></h2>
	<div class="compact">
		<button type="button" class="wechat-code" data-open-code="wechat" aria-label={`放大${snc.name}${wechat.codeName}`} aria-haspopup="dialog" aria-controls="snc-code-wechat">
			<img src={wechat.source} width="96" height="96" alt={`${snc.name}${wechat.codeName}`} loading="lazy" />
			<span>点击放大二维码</span>
		</button>
		<nav class="social-links" aria-label="SNC 社交账号">
			{accounts.map((account) => (
				<div class="compact-row">
					<a href={account.href} aria-label={`${snc.name} ${account.name}`} title={`${snc.name} ${account.identifier}`}>
						<span class="social-icon"><img src={account.icon.src} width="18" height="18" alt="" loading="lazy" /></span>
						<span>{account.name}</span>
					</a>
					{account.id !== 'wechat' && (
						<button type="button" class="small-code" data-open-code={account.id} aria-label={`查看${snc.name}${account.codeName}`} aria-haspopup="dialog" aria-controls={`snc-code-${account.id}`}>
							<FooterIcon name="qr" size={18} />
						</button>
					)}
				</div>
			))}
		</nav>
	</div>
	<div class="code-grid">
		{accounts.map((account) => (
			<div class="code-item">
				<button type="button" class:list={['code', { native: account.code.kind === 'asset' }]} data-open-code={account.id} aria-label={`放大${snc.name}${account.codeName}`} aria-haspopup="dialog" aria-controls={`snc-code-${account.id}`}>
					<img src={account.source} width="112" height="112" alt={`${snc.name}${account.codeName}`} loading="lazy" />
				</button>
				<a class="code-label" href={account.href} aria-label={`${snc.name} ${account.name}`} title={`${snc.name} ${account.identifier}`}>
					<span class="social-icon"><img src={account.icon.src} width="16" height="16" alt="" loading="lazy" /></span>
					<span>{account.name}</span>
				</a>
			</div>
		))}
	</div>
	{accounts.map((account) => (
		<dialog id={`snc-code-${account.id}`} aria-labelledby={`snc-code-title-${account.id}`} aria-describedby={`snc-code-hint-${account.id}`}>
			<button type="button" class="close-code" aria-label="关闭二维码"><FooterIcon name="close" size={20} /></button>
			<h2 id={`snc-code-title-${account.id}`}>{snc.name}</h2>
			<p class="account-id">{account.name} {account.identifier}</p>
			<img src={account.source} width="256" height="256" alt={`${snc.name}${account.codeName}`} loading="lazy" />
			<p id={`snc-code-hint-${account.id}`}>{account.hint}</p>
			{account.id !== 'wechat' && <a class="profile" href={account.href}>前往主页 <FooterIcon name="external" size={14} /></a>}
		</dialog>
	))}
</snc-socials>

<script>
	class SncSocials extends HTMLElement {
		connectedCallback() {
			if (this.dataset.initialized) return;
			this.dataset.initialized = 'true';
			this.querySelectorAll<HTMLButtonElement>('[data-open-code]').forEach((button) => {
				button.addEventListener('click', () => {
					const dialog = this.querySelector<HTMLDialogElement>(`#snc-code-${button.dataset.openCode}`);
					if (dialog && !dialog.open) dialog.showModal();
				});
			});
			this.querySelectorAll<HTMLDialogElement>('dialog').forEach((dialog) => {
				dialog.querySelector('button')?.addEventListener('click', () => dialog.close());
				dialog.addEventListener('click', (event) => {
					if (event.target !== dialog) return;
					const bounds = dialog.getBoundingClientRect();
					if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) dialog.close();
				});
			});
		}
	}
	if (!customElements.get('snc-socials')) customElements.define('snc-socials', SncSocials);
</script>

<style>
	snc-socials { display: block; min-width: 0; padding-inline-start: 1rem; }
	h2 { margin: 0 0 0.875rem; font-size: 0.875rem; font-weight: 600; line-height: 1.5; }
	snc-socials > h2 { display: flex; flex-direction: column; align-items: flex-start; gap: 0.375rem; }
	.account-name { color: var(--md-sys-color-on-surface-variant); font-size: 0.75rem; font-weight: 400; }
	button, a { color: inherit; font: inherit; }
	a { text-decoration: none; }
	button { border: 0; background: none; padding: 0; }
	a:focus-visible, button:focus-visible { outline: 2px solid var(--md-sys-color-primary); outline-offset: 4px; }
	.compact { display: flex; align-items: flex-start; gap: 1.25rem; }
	.wechat-code { display: block; flex: none; width: 5.5rem; border-radius: 0.75rem; cursor: zoom-in; font-size: 0.625rem; }
	.wechat-code img { display: block; width: 100%; height: auto; border-radius: 0.625rem; }
	.wechat-code > span { display: block; margin-top: 0.5rem; }
	.social-links { display: flex; flex-direction: column; }
	.compact-row { display: grid; grid-template-columns: 1fr 2.75rem; align-items: center; gap: 0.375rem; }
	.compact-row a { display: inline-flex; align-items: center; gap: 0.5rem; min-height: 1.875rem; font-size: 0.8125rem; white-space: nowrap; }
	.social-icon { display: inline-flex; flex: none; align-items: center; justify-content: center; width: 1.625rem; height: 1.625rem; border-radius: 50%; background: color-mix(in srgb, var(--md-sys-color-surface) 85%, transparent); }
	.social-icon img { display: block; width: 1.125rem; height: 1.125rem; }
	:global([data-theme='dark']) .social-icon { background: var(--md-sys-color-inverse-surface); }
	.small-code, .close-code { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 50%; cursor: pointer; }
	.small-code { color: var(--md-sys-color-on-surface-variant); }
	.small-code:hover, .close-code:hover { background: var(--md-sys-color-primary-container); }
	.code-grid { display: none; }
	dialog { inset: 0; margin: auto; width: min(22rem, calc(100vw - 2rem)); height: fit-content; min-height: 0; min-width: 0; max-height: calc(100dvh - 2rem); overflow: auto; padding: 2rem 1.5rem 1.25rem; border: 1px solid var(--md-sys-color-outline-variant); border-radius: 1.5rem; background: var(--md-sys-color-surface-container-low); color: var(--md-sys-color-on-surface); box-shadow: var(--md-sys-elevation-level3); }
	dialog::backdrop { background: color-mix(in srgb, var(--md-sys-color-scrim) 32%, transparent); }
	dialog h2 { font-size: 1rem; margin: 0 2rem 0.375rem 0; }
	dialog > img { display: block; width: min(100%, 16rem); height: auto; margin-inline: auto; border-radius: 1rem; background: white; }
	dialog p { margin: 1rem 0 0; font-size: 0.8125rem; line-height: 1.7; text-align: center; }
	dialog .account-id { margin: 0 0 1.25rem; color: var(--md-sys-color-on-surface-variant); font-size: 0.75rem; text-align: start; }
	.close-code { position: absolute; top: 0.5rem; right: 0.5rem; }
	dialog .profile { display: flex; align-items: center; gap: 0.375rem; width: fit-content; margin: 0.75rem auto 0; padding: 0.5rem 1rem; color: var(--md-sys-color-primary); font-size: 0.8125rem; }
	@media (min-width: 1101px) {
		snc-socials > h2 { margin-bottom: 1rem; }
		.compact { display: none; }
		.code-grid { display: grid; grid-template-columns: repeat(3, 7rem); gap: 1rem; }
		.code-item { display: flex; flex-direction: column; align-items: center; gap: 0.5rem; }
		.code { display: block; width: 7rem; height: 7rem; border-radius: 0.875rem; cursor: zoom-in; background: white; }
		.code img { display: block; width: 100%; height: 100%; border-radius: inherit; }
		.code.native { background: transparent; }
		.code-label { display: inline-flex; align-items: center; justify-content: center; gap: 0.25rem; min-height: 2rem; font-size: 0.75rem; white-space: nowrap; }
		.code-label .social-icon { width: 1.25rem; height: 1.25rem; background: transparent; }
		.code-label .social-icon img { width: 1rem; height: 1rem; }
		:global([data-theme='dark']) .code-label .social-icon { background: var(--md-sys-color-inverse-surface); }
	}
	@media (max-width: 600px) {
		snc-socials { padding-inline: 1.25rem; }
		.compact { gap: 1.5rem; }
		.wechat-code { width: 6rem; }
		.compact-row a { min-height: 2.75rem; padding-inline: 0.25rem 0.75rem; border-radius: 0.5rem; font-size: 0.75rem; }
		.social-icon { width: 1.375rem; height: 1.375rem; }
	}
	@media (max-width: 359px) {
		snc-socials { padding-inline: 0.75rem; }
		.compact { gap: 0.5rem; }
		.compact-row { gap: 0; }
		.compact-row a { gap: 0.25rem; padding-inline: 0; }
	}
</style>
